generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model User {
    id                     String                  @id
    name                   String
    email                  String
    emailVerified          Boolean                 @default(false)
    image                  String?
    twoFactorEnabled       Boolean?                @default(false)
    role                   String?
    banned                 Boolean?                @default(false)
    banReason              String?
    banExpires             DateTime?
    phone                  String?
    locale                 String?                 @default("en")
    sessions               Session[]
    accounts               Account[]
    twofactors             TwoFactor[]
    addresses              Address[]
    cart                   Cart?
    wishlist               Wishlist?
    reviews                Review[]
    orders                 Order[]
    rider                  Rider?
    notifications          Notification[]
    notificationPreference NotificationPreference?

    createdAt DateTime  @default(now()) @map("created_at")
    updatedAt DateTime  @updatedAt @map("updated_at")
    deletedAt DateTime? @map("deleted_at")

    roleRecord Role? @relation(fields: [role], references: [key], onDelete: Restrict)

    @@unique([email])
    @@index([role])
    @@map("user")
}

model Session {
    id             String   @id
    expiresAt      DateTime
    token          String
    createdAt      DateTime @default(now()) @map("created_at")
    updatedAt      DateTime @updatedAt @map("updated_at")
    ipAddress      String?
    userAgent      String?
    userId         String
    user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    impersonatedBy String?

    @@unique([token])
    @@index([userId])
    @@map("session")
}

model Account {
    id                    String    @id
    accountId             String
    providerId            String
    userId                String
    user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    accessToken           String?
    refreshToken          String?
    idToken               String?
    accessTokenExpiresAt  DateTime?
    refreshTokenExpiresAt DateTime?
    scope                 String?
    password              String?
    createdAt             DateTime  @default(now()) @map("created_at")
    updatedAt             DateTime  @updatedAt @map("updated_at")

    @@index([userId])
    @@map("account")
}

model Verification {
    id         String   @id
    identifier String
    value      String
    expiresAt  DateTime
    createdAt  DateTime @default(now()) @map("created_at")
    updatedAt  DateTime @updatedAt @map("updated_at")

    @@index([identifier])
    @@map("verification")
}

model TwoFactor {
    id                      String    @id
    secret                  String
    backupCodes             String
    userId                  String
    user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    verified                Boolean?  @default(true)
    failedVerificationCount Int?      @default(0)
    lockedUntil             DateTime?

    @@index([secret])
    @@index([userId])
    @@map("twoFactor")
}

model Role {
    id          String  @id @default(cuid())
    key         String  @unique // e.g. "STAFF". This exact value is stored in user.role
    name        String
    description String?
    rank        Int     @default(0)
    isSystem    Boolean @default(false) @map("is_system")

    permissions RolePermission[]
    users       User[]

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@map("roles")
}

model Permission {
    id          String  @id @default(cuid())
    key         String  @unique // e.g. "order.process"
    resource    String // e.g. "order"
    action      String // e.g. "process"
    description String?

    roles RolePermission[]

    createdAt DateTime @default(now()) @map("created_at")

    @@index([resource])
    @@map("permissions")
}

model RolePermission {
    roleId       String @map("role_id")
    permissionId String @map("permission_id")

    role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
    permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now()) @map("created_at")

    @@id([roleId, permissionId])
    @@index([permissionId])
    @@map("role_permissions")
}

// Catalog

enum ProductStatus {
    DRAFT
    ACTIVE
    ARCHIVED
}

enum ProductAudience {
    WOMEN
    MEN
    UNISEX
    KIDS
}

model Category {
    id          String  @id @default(cuid())
    parentId    String? @map("parent_id")
    name        String
    nameMy      String?
    slug        String  @unique
    description String?
    imageUrl    String? @map("image_url")
    sortOrder   Int     @default(0) @map("sort_order")
    isActive    Boolean @default(true) @map("is_active")

    parent           Category?        @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
    children         Category[]       @relation("CategoryTree")
    products         Product[]
    couponCategories CouponCategory[]

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@index([parentId, sortOrder])
    @@map("categories")
}

model Brand {
    id        String   @id @default(cuid())
    name      String
    slug      String   @unique
    logoUrl   String?  @map("logo_url")
    isActive  Boolean  @default(true) @map("is_active")
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    products Product[]

    @@map("brands")
}

model Product {
    id            String          @id @default(cuid())
    slug          String          @unique
    name          String
    nameMy        String?         @map("name_my")
    description   String?         @db.Text
    descriptionMy String?         @map("description_my") @db.Text
    categoryId    String          @map("category_id")
    brandId       String?         @map("brand_id")
    audience      ProductAudience @default(UNISEX)
    status        ProductStatus   @default(DRAFT)

    price        Decimal   @db.Decimal(14, 2)
    salePrice    Decimal?  @map("sale_price") @db.Decimal(14, 2)
    saleStartsAt DateTime? @map("sale_starts_at")
    saleEndsAt   DateTime? @map("sale_ends_at")
    isTaxable    Boolean   @default(true) @map("is_taxable")
    weightGrams  Int?      @map("weight_grams")

    isFeatured    Boolean @default(false) @map("is_featured")
    soldCount     Int     @default(0) @map("sold_count")
    ratingAverage Decimal @default(0) @map("rating_average") @db.Decimal(3, 2)
    ratingCount   Int     @default(0) @map("rating_count")

    seoTitle       String? @map("seo_title")
    seoDescription String? @map("seo_description")

    publishedAt DateTime? @map("published_at")
    archivedAt  DateTime? @map("archived_at")
    createdAt   DateTime  @default(now()) @map("created_at")
    updatedAt   DateTime  @updatedAt @map("updated_at")

    category       Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
    brand          Brand?          @relation(fields: [brandId], references: [id], onDelete: SetNull)
    couponProducts CouponProduct[]

    variants      ProductVariant[]
    images        ProductImage[]
    specs         ProductSpecification[]
    reviews       Review[]
    wishlistItems WishlistItem[]

    @@index([status, categoryId])
    @@index([status, createdAt])
    @@index([status, price])
    @@index([status, soldCount])
    @@index([brandId])
    @@index([isFeatured])
    @@map("products")
}

model ProductVariant {
    id                String   @id @default(cuid())
    productId         String   @map("product_id")
    sku               String   @unique
    size              String // "S", "M", "L", "XL", "Free Size"
    color             String // "Black", "Cream", "Default"
    colorHex          String?  @map("color_hex") // "#1F1F1F" for the swatch
    stockOnHand       Int      @default(0) @map("stock_on_hand")
    stockReserved     Int      @default(0) @map("stock_reserved")
    lowStockThreshold Int      @default(5) @map("low_stock_threshold")
    isActive          Boolean  @default(true) @map("is_active")
    sortOrder         Int      @default(0) @map("sort_order")
    createdAt         DateTime @default(now()) @map("created_at")
    updatedAt         DateTime @updatedAt @map("updated_at")

    product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

    movements    InventoryMovement[]
    cartItems    CartItem[]
    orderItems   OrderItem[]
    reservations InventoryReservation[]

    @@unique([productId, size, color])
    @@index([productId, sortOrder])
    @@index([isActive])
    @@map("product_variants")
}

model ProductImage {
    id         String   @id @default(cuid())
    productId  String   @map("product_id")
    url        String
    storageKey String?  @map("storage_key") // key in local disk / S3, used when deleting
    alt        String?
    color      String? // null = shown for all colours; otherwise only for that colour
    width      Int?
    height     Int?
    sortOrder  Int      @default(0) @map("sort_order") // 0 = primary image
    createdAt  DateTime @default(now()) @map("created_at")

    product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

    @@index([productId, sortOrder])
    @@map("product_images")
}

model ProductSpecification {
    id        String @id @default(cuid())
    productId String @map("product_id")
    label     String // "Material"
    value     String // "100% cotton"
    sortOrder Int    @default(0) @map("sort_order")

    product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

    @@index([productId, sortOrder])
    @@map("product_specifications")
}

// Inventory

enum InventoryMovementType {
    INITIAL // first stock when variant is created
    RESTOCK // new stock arrived
    SALE // order placed
    RETURN // customer return put back on shelf
    CANCELLATION // cancelled order put back on shelf
    ADJUSTMENT // manual correction after stock count
    DAMAGE // damaged / lost
}

model InventoryMovement {
    id             String                @id @default(cuid())
    variantId      String                @map("variant_id")
    type           InventoryMovementType
    quantityChange Int                   @map("quantity_change") // signed: +10 restock, -2 sale
    quantityAfter  Int                   @map("quantity_after") // stockOnHand after this movement
    reason         String?
    reference      String? // e.g. "order:ORD-1001"
    actorId        String?               @map("actor_id") // user who did it. Plain text on purpose (see notes)
    createdAt      DateTime              @default(now()) @map("created_at")

    variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

    @@index([variantId, createdAt])
    @@index([type, createdAt])
    @@map("inventory_movements")
}

// Customer addresses

model Address {
    id            String  @id @default(cuid())
    userId        String  @map("user_id")
    label         String? // "Home", "Office"
    recipientName String  @map("recipient_name")
    phone         String // "+959..."
    region        String // "Yangon Region", "Shan State"
    township      String
    ward          String?
    addressLine   String  @map("address_line") // street, house / building number
    landmark      String? // "Near the pagoda", helps riders
    postalCode    String? @map("postal_code")
    isDefault     Boolean @default(false) @map("is_default")

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@map("addresses")
}

// Cart (guest or logged-in)

model Cart {
    id             String    @id @default(cuid())
    userId         String?   @unique @map("user_id")
    guestTokenHash String?   @unique @map("guest_token_hash") // SHA-256 of the cookie token
    couponCode     String?   @map("coupon_code")
    lastActiveAt   DateTime  @default(now()) @map("last_active_at")
    expiresAt      DateTime? @map("expires_at") // set for guest carts

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    user         User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
    items        CartItem[]
    reservations InventoryReservation[]

    @@index([expiresAt])
    @@map("carts")
}

model CartItem {
    id        String @id @default(cuid())
    cartId    String @map("cart_id")
    variantId String @map("variant_id")
    quantity  Int    @default(1)

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
    variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

    @@unique([cartId, variantId])
    @@index([variantId])
    @@map("cart_items")
}

// Wishlist

model Wishlist {
    id     String @id @default(cuid())
    userId String @unique @map("user_id")

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
    items WishlistItem[]

    @@map("wishlists")
}

model WishlistItem {
    id         String @id @default(cuid())
    wishlistId String @map("wish_list_id")
    productId  String @map("product_id")

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
    product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

    @@unique([wishlistId, productId])
    @@index([productId])
    @@map("wishlist_items")
}

// Reviews

enum ReviewStatus {
    PENDING
    APPROVED
    REJECTED
}

model Review {
    id                 String       @id @default(cuid())
    productId          String       @map("product_id")
    userId             String       @map("user_id")
    rating             Int // 1..5 (CHECK in migration)
    title              String?
    body               String?      @db.Text
    status             ReviewStatus @default(PENDING)
    isVerifiedPurchase Boolean      @default(false) @map("is_verified_purchase")
    moderatedAt        DateTime?    @map("moderated_at")
    moderatedBy        String?      @map("moderated_by") // staff user id (plain text on purpose)
    rejectionReason    String?

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
    user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([productId, userId])
    @@index([productId, status, createdAt])
    @@index([userId])
    @@map("reviews")
}

enum ActorType {
    SYSTEM
    CUSTOMER
    STAFF
    RIDER
}

enum OrderStatus {
    PLACED
    CONFIRMED
    PROCESSING
    PACKED
    READY_FOR_SHIPMENT
    SHIPPED
    DELIVERED
    CANCELLED
    RETURNED
}

enum PaymentStatus {
    UNPAID
    PENDING_VERIFICATION
    COD_COLLECTED
    PAID
    FAILED
    VOIDED
    PARTIALLY_REFUNDED
    REFUNDED
}

enum PaymentMethod {
    COD
    MANUAL_TRANSFER
    ONLINE_GATEWAY
}

enum SlipStatus {
    PENDING
    APPROVED
    REJECTED
}

enum RefundStatus {
    PENDING
    COMPLETED
    FAILED
}

enum DiscountType {
    PERCENTAGE
    FIXED_AMOUNT
}

enum ReservationStatus {
    ACTIVE
    COMMITTED
    RELEASED
    EXPIRED
}

// Orders

model Order {
    id             String  @id @default(cuid())
    orderNumber    String  @unique @map("order_number")
    idempotencyKey String  @unique @map("idempotency_key")
    userId         String? @map("user_id") // null = guest checkout

    status        OrderStatus   @default(PLACED)
    paymentStatus PaymentStatus @default(UNPAID) @map("payment_status")
    paymentMethod PaymentMethod @map("payment_method")

    // Customer snapshot
    customerName  String  @map("customer_name")
    customerPhone String  @map("customer_phone")
    customerEmail String? @map("customer_email")

    // Delivery address snapshot
    shipRecipientName String  @map("ship_recipient_name")
    shipPhone         String  @map("ship_phone")
    shipRegion        String  @map("ship_region")
    shipTownship      String  @map("ship_township")
    shipWard          String? @map("ship_ward")
    shipAddressLine   String  @map("ship_address_line")
    shipLandmark      String? @map("ship_land_mark")
    shipPostalCode    String? @map("ship_postal_code")

    // Shipping method snapshot (methods and zones are defined in Step 1.3f)
    shippingMethodCode String @map("shipping_method_code")
    shippingMethodName String @map("shipping_method_name")

    // Money
    currency      String  @default("MMK") @db.VarChar(3)
    subtotal      Decimal @db.Decimal(14, 2) // sum of unitPrice * quantity (after sale prices)
    discountTotal Decimal @default(0) @map("discount_total") @db.Decimal(14, 2) // coupon discount
    shippingFee   Decimal @default(0) @map("shipping_fee") @db.Decimal(14, 2)
    taxTotal      Decimal @default(0) @map("tax_total") @db.Decimal(14, 2)
    total         Decimal @db.Decimal(14, 2)
    refundedTotal Decimal @default(0) @map("refunded_total") @db.Decimal(14, 2)
    couponCode    String? @map("coupon_code")

    customerNote String? @map("customer_note") @db.Text
    internalNote String? @map("internal_note") @db.Text

    placedAt            DateTime  @default(now()) @map("placed_at")
    confirmedAt         DateTime? @map("confirmed_at")
    paidAt              DateTime? @map("paid_at")
    deliveredAt         DateTime? @map("delivered_at")
    cancelledAt         DateTime? @map("cancelled_at")
    cancelReason        String?   @map("cancel_reason")
    cancelRequestedAt   DateTime? @map("cancel_request_at")
    cancelRequestReason String?   @map("cancel_request_reason")

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    user             User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
    items            OrderItem[]
    payments         Payment[]
    events           OrderEvent[]
    couponRedemption CouponRedemption?
    reservations     InventoryReservation[]
    shipments        Shipment[]
    codCollections   CodCollection[]

    @@index([userId, createdAt])
    @@index([status, createdAt])
    @@index([paymentStatus, createdAt])
    @@index([customerPhone])
    @@index([createdAt])
    @@map("orders")
}

model OrderItem {
    id        String  @id @default(cuid())
    orderId   String  @map("order_id")
    variantId String? @map("variant_id") // kept as a link while the variant exists
    productId String? @map("product_id") // plain text on purpose (history survives product changes)

    // Snapshots
    productName    String   @map("product_name")
    sku            String
    size           String
    color          String
    imageUrl       String?  @map("image_url")
    unitPrice      Decimal  @map("unit_price") @db.Decimal(14, 2) // price actually charged per unit
    compareAtPrice Decimal? @map("compare_at_price") @db.Decimal(14, 2) // regular price when a sale price applied

    quantity       Int
    discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(14, 2) // share of the coupon discount
    taxAmount      Decimal @default(0) @map("tax_amount") @db.Decimal(14, 2)
    lineTotal      Decimal @map("line_total") @db.Decimal(14, 2) // unitPrice * quantity - discountAmount

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
    variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

    @@index([orderId])
    @@index([variantId])
    @@index([productId])
    @@map("order_items")
}

// Append-only order history. Rows are only ever added, so there is no updated_at.
model OrderEvent {
    id         String    @id @default(cuid())
    orderId    String    @map("order_id")
    type       String // e.g. ORDER_PLACED, STATUS_CHANGED, PAYMENT_UPDATED, NOTE_ADDED
    fromStatus String?   @map("from_status")
    toStatus   String?   @map("to_status")
    message    String?
    actorType  ActorType @default(SYSTEM) @map("actor_type")
    actorId    String?   @map("actor_id") // plain text on purpose
    createdAt  DateTime  @default(now()) @map("created_at")

    order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

    @@index([orderId, createdAt])
    @@map("order_events")
}

// Payments

model Payment {
    id                String        @id @default(cuid())
    orderId           String        @map("order_id")
    method            PaymentMethod
    provider          String // "cod", "manual-transfer", "dev-gateway", later a real gateway
    status            PaymentStatus @default(UNPAID)
    amount            Decimal       @db.Decimal(14, 2)
    currency          String        @default("MMK") @db.VarChar(3)
    providerReference String?       @map("provider_reference") // gateway transaction id. Never card details
    failureReason     String?       @map("failure_reason")
    paidAt            DateTime?     @map("paid_at")

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    order   Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
    slips   PaymentSlip[]
    refunds Refund[]

    @@unique([provider, providerReference])
    @@index([orderId])
    @@index([status, createdAt])
    @@map("payments")
}

model PaymentSlip {
    id                String     @id @default(cuid())
    paymentId         String     @map("payment_id")
    channel           String // "KBZPAY", "WAVEPAY", "AYAPAY", "CBPAY", "BANK"
    transferReference String?    @map("transfer_reference")
    amountClaimed     Decimal?   @map("amount_claimed") @db.Decimal(14, 2)
    imageUrl          String     @map("image_url")
    storageKey        String?    @map("storage_key")
    status            SlipStatus @default(PENDING)
    reviewedBy        String?    @map("reviewed_by") // staff user id (plain text on purpose)
    reviewedAt        DateTime?  @map("reviewed_at")
    rejectionReason   String?    @map("rejection_reason")

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

    @@index([paymentId])
    @@index([status, createdAt])
    @@map("payment_slips")
}

model Refund {
    id                String       @id @default(cuid())
    paymentId         String       @map("payment_id")
    amount            Decimal      @db.Decimal(14, 2)
    reason            String?
    status            RefundStatus @default(PENDING)
    providerReference String?      @map("provider_reference")
    requestedBy       String?      @map("requested_by")
    processedBy       String?      @map("processed_by")
    processedAt       DateTime?    @map("processed_at")

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

    @@index([paymentId])
    @@index([status])
    @@map("refunds")
}

// Idempotency for payment AND carrier webhooks: each event is processed once.
model ProcessedWebhookEvent {
    id        String   @id @default(cuid())
    source    String // "payment:<provider>" or "carrier:<carrier>"
    eventId   String   @map("event_id")
    eventType String?  @map("event_type")
    createdAt DateTime @default(now()) @map("created_at")

    @@unique([source, eventId])
    @@index([createdAt])
    @@map("processed_webhook_events")
}

// Coupons

model Coupon {
    id                String       @id @default(cuid())
    code              String       @unique // always uppercase (CHECK in migration)
    description       String?
    discountType      DiscountType @map("discount_type")
    value             Decimal      @db.Decimal(14, 2) // percent (1-100) or amount in MMK
    maxDiscountAmount Decimal?     @map("max_discount_amount") @db.Decimal(14, 2) // cap for percentage coupons
    minOrderAmount    Decimal?     @map("min_order_amount") @db.Decimal(14, 2)
    usageLimit        Int?         @map("usage_limit") // total uses allowed
    usageLimitPerUser Int?         @map("usage_limit_per_user")
    usedCount         Int          @default(0) @map("used_count")
    excludeSaleItems  Boolean      @default(false) @map("exclude_sale_items")
    startsAt          DateTime?    @map("starts_at")
    expiresAt         DateTime?    @map("expires_at")
    isActive          Boolean      @default(true) @map("is_active")
    createdBy         String?      @map("created_by")

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    products    CouponProduct[]
    categories  CouponCategory[]
    redemptions CouponRedemption[]

    @@index([isActive, expiresAt])
    @@map("coupons")
}

// If a coupon has rows here, it applies ONLY to those products / categories.
model CouponProduct {
    couponId  String @map("coupon_id")
    productId String @map("product_id")

    coupon  Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
    product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

    @@id([couponId, productId])
    @@index([productId])
    @@map("coupon_products")
}

model CouponCategory {
    couponId   String @map("coupon_id")
    categoryId String @map("category_id")

    coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
    category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

    @@id([couponId, categoryId])
    @@index([categoryId])
    @@map("coupon_categories")
}

model CouponRedemption {
    id             String  @id @default(cuid())
    couponId       String  @map("coupon_id")
    orderId        String  @unique @map("order_id") // one coupon per order
    userId         String? @map("user_id") // null for guests
    customerPhone  String  @map("customer_phone") // lets us limit guest usage by phone
    discountAmount Decimal @map("discount_amount") @db.Decimal(14, 2)

    createdAt DateTime @default(now()) @map("created_at")

    coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
    order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

    @@index([couponId, userId])
    @@index([couponId, customerPhone])
    @@map("coupon_redemptions")
}

// Stock reservations (see "Stock lifecycle" in the guide)

model InventoryReservation {
    id                String            @id @default(cuid())
    checkoutSessionId String            @map("checkout_session_id") // groups all lines of one checkout attempt
    variantId         String            @map("variant_id")
    cartId            String?           @map("cart_id")
    orderId           String?           @map("order_id") // set when the reservation is committed
    quantity          Int
    status            ReservationStatus @default(ACTIVE)
    expiresAt         DateTime          @map("expires_at")
    releasedAt        DateTime?         @map("released_at")

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
    cart    Cart?          @relation(fields: [cartId], references: [id], onDelete: SetNull)
    order   Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)

    @@unique([checkoutSessionId, variantId])
    @@index([status, expiresAt])
    @@index([variantId, status])
    @@index([orderId])
    @@map("inventory_reservations")
}

// Delivery

enum FulfillmentType {
    IN_HOUSE
    THIRD_PARTY
}

enum ShipmentStatus {
    PENDING
    SHIPPED
    IN_TRANSIT
    OUT_FOR_DELIVERY
    DELIVERED
    DELIVERY_FAILED
    RETURNED_TO_SENDER
    CANCELLED
}

enum TrackingSource {
    SYSTEM
    ADMIN
    RIDER
    CARRIER_WEBHOOK
    CARRIER_POLL
    SIMULATED
}

enum CodStatus {
    PENDING
    COLLECTED
    RECONCILED
    DISCREPANCY
}

enum RiderStatus {
    OFF_DUTY
    AVAILABLE
    ON_DELIVERY
}

model Carrier {
    id                  String          @id @default(cuid())
    code                String          @unique // "in-house", "mock-express"
    name                String
    type                FulfillmentType
    trackingUrlTemplate String?         @map("tracking_url_template") // "https://example.com/track/{trackingNumber}"
    supportPhone        String?         @map("support_phone")
    isActive            Boolean         @default(true) @map("is_active")

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    methods   ShippingMethod[]
    shipments Shipment[]

    @@map("carriers")
}

model DeliveryZone {
    id        String  @id @default(cuid())
    name      String
    region    String // "Yangon Region"
    township  String // "Bahan"
    isActive  Boolean @default(true) @map("is_active")
    sortOrder Int     @default(0) @map("sort_order")

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    rates  ShippingRate[]
    riders RiderZone[]

    @@unique([region, township])
    @@map("delivery_zones")
}

model ShippingMethod {
    id           String          @id @default(cuid())
    code         String          @unique // stored on orders as a snapshot
    name         String
    description  String?
    type         FulfillmentType
    carrierId    String?         @map("carrier_id")
    codAvailable Boolean         @default(true) @map("cod_available")
    etaMinDays   Int             @default(1) @map("eta_min_days")
    etaMaxDays   Int             @default(3) @map("eta_max_days")
    isActive     Boolean         @default(true) @map("is_active")
    sortOrder    Int             @default(0) @map("sort_order")

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    carrier Carrier?       @relation(fields: [carrierId], references: [id], onDelete: Restrict)
    rates   ShippingRate[]

    @@index([isActive, sortOrder])
    @@map("shipping_methods")
}

model ShippingRate {
    id               String   @id @default(cuid())
    methodId         String   @map("method_id")
    zoneId           String   @map("zone_id")
    fee              Decimal  @db.Decimal(14, 2)
    freeShippingOver Decimal? @map("free_shipping_over") @db.Decimal(14, 2)

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    method ShippingMethod @relation(fields: [methodId], references: [id], onDelete: Cascade)
    zone   DeliveryZone   @relation(fields: [zoneId], references: [id], onDelete: Cascade)

    @@unique([methodId, zoneId])
    @@index([zoneId])
    @@map("shipping_rates")
}

model Rider {
    id           String      @id @default(cuid())
    userId       String      @unique @map("user_id")
    phone        String
    vehicleType  String?     @map("vehicle_type") // "Motorbike", "Bicycle"
    vehiclePlate String?     @map("vehicle_plate")
    status       RiderStatus @default(OFF_DUTY)
    isActive     Boolean     @default(true) @map("is_active")

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    user           User            @relation(fields: [userId], references: [id], onDelete: Restrict)
    zones          RiderZone[]
    shipments      Shipment[]
    codCollections CodCollection[]

    @@index([isActive, status])
    @@map("riders")
}

model RiderZone {
    riderId String @map("rider_id")
    zoneId  String @map("zone_id")

    rider Rider        @relation(fields: [riderId], references: [id], onDelete: Cascade)
    zone  DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

    @@id([riderId, zoneId])
    @@index([zoneId])
    @@map("rider_zones")
}

model Shipment {
    id                  String          @id @default(cuid())
    orderId             String          @map("order_id")
    type                FulfillmentType
    status              ShipmentStatus  @default(PENDING)
    carrierId           String?         @map("carrier_id")
    riderId             String?         @map("rider_id")
    trackingNumber      String?         @map("tracking_number")
    carrierReference    String?         @map("carrier_reference") // carrier's own internal reference
    estimatedDeliveryAt DateTime?       @map("estimated_delivery_at")
    shippedAt           DateTime?       @map("shipped_at")
    deliveredAt         DateTime?       @map("delivered_at")
    deliveryAttempts    Int             @default(0) @map("delivery_attempts")
    lastFailureReason   String?         @map("last_failure_reason")
    deliveryNotes       String?         @map("delivery_notes") @db.Text
    proofOfDeliveryUrl  String?         @map("proof_of_delivery_url")
    receivedBy          String?         @map("received_by") // who signed for the parcel
    codAmount           Decimal         @default(0) @map("cod_amount") @db.Decimal(14, 2) // cash to collect, 0 if prepaid

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
    carrier       Carrier?        @relation(fields: [carrierId], references: [id], onDelete: Restrict)
    rider         Rider?          @relation(fields: [riderId], references: [id], onDelete: Restrict)
    events        TrackingEvent[]
    codCollection CodCollection?

    @@unique([carrierId, trackingNumber])
    @@index([orderId])
    @@index([status, createdAt])
    @@index([riderId, status])
    @@index([carrierId, status])
    @@map("shipments")
}

// Append-only timeline. Rows are only ever added, so there is no updated_at.
model TrackingEvent {
    id             String         @id @default(cuid())
    shipmentId     String         @map("shipment_id")
    status         ShipmentStatus
    title          String
    description    String?
    location       String?
    failureReason  String?        @map("failure_reason")
    occurredAt     DateTime       @map("occurred_at")
    source         TrackingSource
    isSimulated    Boolean        @default(false) @map("is_simulated")
    carrierEventId String?        @map("carrier_event_id") // the carrier's own event id, used for idempotency
    actorId        String?        @map("actor_id") // plain text on purpose
    rawPayload     Json?          @map("raw_pay_load")

    createdAt DateTime @default(now()) @map("created_at")

    shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

    @@unique([shipmentId, carrierEventId])
    @@index([shipmentId, occurredAt])
    @@map("tracking_events")
}

model CodCollection {
    id              String    @id @default(cuid())
    shipmentId      String    @unique @map("shipment_id")
    orderId         String    @map("order_id")
    riderId         String?   @map("rider_id")
    amountDue       Decimal   @map("amount_due") @db.Decimal(14, 2)
    amountCollected Decimal   @default(0) @map("amount_collected") @db.Decimal(14, 2)
    status          CodStatus @default(PENDING)
    collectedAt     DateTime? @map("collected_at")
    reconciledAt    DateTime? @map("reconciled_at")
    reconciledBy    String?   @map("reconciled_by") // plain text on purpose
    note            String?

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
    order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
    rider    Rider?   @relation(fields: [riderId], references: [id], onDelete: Restrict)

    @@index([status, createdAt])
    @@index([riderId, status])
    @@index([orderId])
    @@map("cod_collections")
}

// Notifications

enum OutboxChannel {
    EMAIL
    SMS
}

enum OutboxStatus {
    PENDING
    SENT
    FAILED
    SKIPPED
}

model Notification {
    id        String    @id @default(cuid())
    userId    String    @map("user_id")
    type      String // e.g. ORDER_PLACED, ORDER_SHIPPED, OUT_FOR_DELIVERY
    title     String
    body      String?
    link      String?
    data      Json?
    dedupeKey String?   @unique @map("dedupe_key") // prevents duplicates when webhooks are retried
    readAt    DateTime? @map("read_at")

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId, readAt, createdAt])
    @@map("notifications")
}

model NotificationPreference {
    id                String  @id @default(cuid())
    userId            String  @unique @map("user_id")
    emailOrderUpdates Boolean @default(true) @map("email_order_updates")
    emailPromotions   Boolean @default(false) @map("email_promotions")
    smsOrderUpdates   Boolean @default(false) @map("sms_order_updates")

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@map("notification_preferences")
}

// Outbox pattern: we save the message in the same transaction as the business
// change, then a worker sends it and retries on failure.
model OutboxMessage {
    id            String        @id @default(cuid())
    channel       OutboxChannel
    recipient     String
    subject       String?
    body          String        @db.Text
    status        OutboxStatus  @default(PENDING)
    attempts      Int           @default(0)
    lastError     String?       @map("last_error")
    nextAttemptAt DateTime      @default(now()) @map("next_attempt_at")
    sentAt        DateTime?     @map("sent_at")
    dedupeKey     String?       @unique @map("dedupe_key")

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@index([status, nextAttemptAt])
    @@map("outbox_messages")
}

// Audit log (append-only) and store settings (single row)

model AuditLog {
    id         String  @id @default(cuid())
    actorId    String? @map("actor_id") // plain text on purpose
    actorRole  String? @map("actor_role")
    action     String // e.g. "order.cancel", "shipment.update_status"
    entityType String  @map("entity_type") // e.g. "Order"
    entityId   String? @map("entity_id")
    summary    String?
    before     Json?
    after      Json?
    ipAddress  String? @map("ip_address")
    userAgent  String? @map("user_agent")

    createdAt DateTime @default(now()) @map("created_at")

    @@index([entityType, entityId])
    @@index([actorId, createdAt])
    @@index([action, createdAt])
    @@index([createdAt])
    @@map("audit_logs")
}

model StoreSettings {
    id                     String  @id @default("default")
    currency               String  @default("MMK") @db.VarChar(3)
    locale                 String  @default("en")
    timeZone               String  @default("Asia/Yangon") @map("time_zone")
    taxEnabled             Boolean @default(false) @map("tax_enabled")
    taxRate                Decimal @default(0) @map("tax_rate") @db.Decimal(5, 2) // percent
    taxLabel               String  @default("Commercial tax") @map("tax_label")
    guestCheckoutEnabled   Boolean @default(true) @map("guest_checkout_enabled")
    codEnabled             Boolean @default(true) @map("cod_enabled")
    manualTransferEnabled  Boolean @default(true) @map("manual_transfer_enabled")
    onlineGatewayEnabled   Boolean @default(false) @map("online_gateway_enabled")
    reservationMinutes     Int     @default(15) @map("reservation_minutes")
    unpaidOrderExpiryHours Int     @default(24) @map("unpaid_order_expiry_hours")
    returnWindowDays       Int     @default(7) @map("return_window_days")
    supportPhone           String? @map("support_phone")
    supportEmail           String? @map("support_email")
    manualTransferAccounts Json?   @map("manual_transfer_accounts") // [{ channel, accountName, accountNumber }]
    shippingPolicy         String? @map("shipping_policy") @db.Text
    returnPolicy           String? @map("return_policy") @db.Text
    privacyPolicy          String? @map("privacy_policy") @db.Text
    terms                  String? @db.Text

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@map("store_settings")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}
