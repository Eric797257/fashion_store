# ---------- App ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- Database (used by Docker AND the app) ----------
POSTGRES_DB=store
POSTGRES_USER=store_user
POSTGRES_PASSWORD=change_me_locally
# Keep the password URL-safe (letters/numbers) or URL-encode special characters
DATABASE_URL=postgresql://store_user:change_me_locally@localhost:5432/store?schema=public

# ---------- Better Auth (used from Step 2) ----------
BETTER_AUTH_SECRET=            # generate: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000

# ---------- Social login (leave empty to hide the buttons) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ---------- Email (dev uses Mailpit) ----------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Brand Store <no-reply@example.com>"

# ---------- SMS (disabled unless a real provider is added) ----------
SMS_PROVIDER=none

# ---------- Payments / Carriers ----------
PAYMENT_MODE=dev               # dev | live
PAYMENT_WEBHOOK_SECRET=
CARRIER_MODE=mock              # mock | live
CARRIER_WEBHOOK_SECRET=

# ---------- File storage ----------
STORAGE_DRIVER=local            # local | cloudinary | s3   (switch to cloudinary when ready)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=          # server only. Never put in NEXT_PUBLIC_ variables

# ---------- Seeding ----------
SEED_SAMPLE_DATA=true           # adds clearly labelled sample products. Never true in production